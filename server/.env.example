# Copy this file to server/.env and fill in your key.
# Get one at https://console.anthropic.com/ -> API keys
ANTHROPIC_API_KEY=sk-ant-...

# Model powering the ghost. Default: claude-opus-4-8 (smartest).
# For the cheapest possible public widget use: claude-haiku-4-5
ANTHROPIC_MODEL=claude-opus-4-8

# Port the server listens on
GHOST_PORT=8787

# Comma-separated origins allowed to call this API
GHOST_ORIGINS=http://localhost:5173,https://karansurana.github.io

# ── abuse controls ──────────────────────────────────────────
# Requests per minute per IP
GHOST_RPM_LIMIT=10
# Requests per day per IP
GHOST_DAILY_IP_LIMIT=40
# Total Claude calls per day; past this the ghost degrades to the
# free mock brain instead of spending money (hard spend ceiling)
GHOST_DAILY_GLOBAL_LIMIT=500
# Reject requests whose Origin header isn't in GHOST_ORIGINS
# (stops casual scripts; set to false only for curl testing)
GHOST_ENFORCE_ORIGIN=true
